    {
      "parameters": {
        "connectionMode": "docker",
        "operation": "resumeSession",
        "sessionId": "7b3e9c2a-1d4f-4a6b-9c8e-2f0a5d7b1e30",
        "prompt": "=Here is my activity data for today. Use ONLY this data — do not invent anything.\n\n{{ $json.activity }}\n\nWrite my daily standup in EXACTLY three sections, each as a bulleted list:\n\nYesterday:\nToday:\nBlockers:\n\nKeep it concise. If a section has no data, write \"• (nothing)\". Start the message with \"📋 Daily Standup — {{ $json.date }}\".",
        "options": {
          "systemPromptMode": "replace",
          "systemPrompt": "You are a daily-standup assistant. You receive raw activity data (GitHub commits, Redmine issues, Slack messages) and turn it into a crisp standup with three sections: Yesterday, Today, Blockers. Rules: use ONLY the provided data, never fabricate items, infer Today's plan from in-progress Redmine issues, and surface anything that reads like a blocker. Remember prior standups in this session so you can answer follow-up questions like 'what did I report yesterday?'.",
          "outputFormat": "json"
        }
      },
