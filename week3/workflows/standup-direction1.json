              "id": "input-gate-cond",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
      "name": "Input Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
