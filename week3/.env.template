# ============================================================================
# Week 3 — N8N Standup Bot secrets & config
# Copy this file to: n8n-nodes-claude-code-cli/docker/production/n8n-with-claude-code/.env
# Fill every value, then `docker compose up -d --build` (or `docker compose up -d` to reload env).
# Referenced inside n8n via {{$env.VAR}} expressions in the HTTP Request nodes.
# ============================================================================

# --- GitHub (commits in last 7 days) ---
# Fine-grained or classic PAT with repo:read (Contents/Commits). https://github.com/settings/tokens
# NOTE: comments on their own lines only. docker env_file keeps everything
# after '=' as the value (inline '# ...' becomes part of the value). Keep values bare.
GITHUB_TOKEN=
# GITHUB_OWNER e.g. zigexn-ven
GITHUB_OWNER=
# GITHUB_REPO e.g. sell_trade
GITHUB_REPO=

# --- Redmine (issues assigned to me, updated today) ---
# REDMINE_BASE_URL e.g. https://redmine.example.com  (no trailing slash)
REDMINE_BASE_URL=
# REDMINE_API_KEY: My Account -> API access key
REDMINE_API_KEY=

# --- Slack ---
# Bot token (xoxb-...) scopes: channels:history, groups:history, chat:write, im:write.
# Bot must be invited into the READ channel. For DM post, no invite needed.
SLACK_BOT_TOKEN=
# SLACK_FETCH_CHANNEL_ID: channel to READ today's messages, e.g. C0123456789
SLACK_FETCH_CHANNEL_ID=
# SLACK_POST_CHANNEL_ID: your Slack member ID U... (Profile -> ... -> Copy member ID) -> posts to your DM
SLACK_POST_CHANNEL_ID=

# --- Claude Code session (memory persistence) ---
# Fixed UUID = the "standup-phong" session. Keep it constant across runs so memory persists.
# Seed once:  docker exec claude-code-runner claude --session-id $STANDUP_SESSION_ID -p "standup session init"
STANDUP_SESSION_ID=7b3e9c2a-1d4f-4a6b-9c8e-2f0a5d7b1e30

# Redmine site nginx basic-auth, base64 of "user:pass":  printf "u:p" | base64
REDMINE_BASIC_B64=

# --- Harness fault-injection (red→green demo only; leave blank normally) ---
# Set to "input" or "output" to force the matching validation gate to FAIL,
# proving the backpressure gate blocks the Slack post + reds the execution.
# Blank/unset = normal green runs.
STANDUP_FORCE_FAIL=
